{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gruppenwahl",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "pfad": {
      "enum": [
        "ahmet",
        "fatma",
        "olli",
        "can"
      ]
    },
    "runde": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "hinweis",
    "wertung",
    "wahlen"
  ],
  "additionalProperties": false,
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "wertung": {
      "type": "object",
      "required": [
        "kooperativ",
        "eigennuetzig",
        "sabotage"
      ],
      "additionalProperties": false,
      "properties": {
        "kooperativ": {
          "const": 1
        },
        "eigennuetzig": {
          "const": 0
        },
        "sabotage": {
          "const": -1
        }
      }
    },
    "wahlen": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rolle",
          "runde",
          "quelle",
          "platzhalter",
          "a",
          "b"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "rolle": {
            "$ref": "#/$defs/id"
          },
          "runde": {
            "$ref": "#/$defs/runde"
          },
          "quelle": {
            "enum": [
              "geheimnis",
              "loyalitaet"
            ]
          },
          "platzhalter": {
            "type": "boolean"
          },
          "a": {
            "type": "object",
            "required": [
              "text",
              "kosten",
              "nutzen"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kosten": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              },
              "nutzen": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              }
            }
          },
          "b": {
            "type": "object",
            "required": [
              "text",
              "kosten",
              "nutzen"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kosten": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              },
              "nutzen": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              }
            }
          },
          "bTaeter": {
            "type": "object",
            "required": [
              "text",
              "art",
              "kosten",
              "nutzen"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "art": {
                "const": "sabotage"
              },
              "kosten": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              },
              "nutzen": {
                "type": "object",
                "required": [
                  "art"
                ],
                "additionalProperties": false,
                "properties": {
                  "art": {
                    "enum": [
                      "gruppe",
                      "geheimnis",
                      "freund",
                      "ziel",
                      "tarnung"
                    ]
                  },
                  "bezug": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9_]*$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
